# Copiar a .env (permisos 600) y completar. NUNCA commitear .env a git.
# Fuente canónica de variables de instancia — la leen los scripts operativos.

# IP Tailscale del lab (rehome.sh la actualiza en migraciones)
LAB_IP=

# Bot de Telegram del lab (el mismo que usa Hermes, u otro dedicado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backblaze B2 — backup restic (key writer; la admin NO va aquí)
B2_ACCOUNT_ID=
B2_BACKUP_KEY=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# URLs de push de monitores tipo "Push" en Uptime Kuma
KUMA_PUSH_URL=
CPU_TEMP_KUMA_PUSH_URL=
CENTRO_KUMA_PUSH_URL=
