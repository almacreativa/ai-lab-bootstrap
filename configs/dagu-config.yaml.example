# Dagu server configuration
# Copy to ~/.config/dagu/config.yaml and adjust host/port
# Docs: https://dagu.readthedocs.io/
#
# GOTCHA data dirs: el wizard del installer oficial (system install) usa
# /var/lib/dagu como data dir; un install de usuario usa ~/.local/share/dagu.
# El lab corre UN solo service system con --config apuntando a este archivo
# (dags en ~/.config/dagu/dags). Si Dagu "pierde historial", verificar que no
# haya dos services con data dirs distintos (ver configs/dagu.service).

host: 0.0.0.0
port: 8480
dags_dir: {{HOME}}/.config/dagu/dags
base_config: {{HOME}}/.config/dagu/base.yaml
default_shell: /bin/bash
tz: America/Costa_Rica
auth:
  mode: builtin
ui:
  navbar_title: "{{HOSTNAME}} Lab"
  navbar_color: "#1a1a2e"
env_passthrough_prefixes:
  - TELEGRAM_
  - PAPERCLIP_
  - DAGU_
