# Odysseus stack — i7local Lab
# SearXNG: usa el del lab (container 'searxng' en ai-lab-net)
# ChromaDB: instancia dedicada para Odysseus (RAG/memoria vectorial, no existia en el lab)
# Ollama: NO local. Reservado para GPU remota Tailscale cuando este disponible.

services:
  odysseus:
    build: {{LAB_DIR}}/repos/odysseus
    container_name: odysseus
    ports:
      - "7000:7000"
    volumes:
      - {{LAB_DIR}}/data/core/odysseus/data:/app/data:z
      - {{LAB_DIR}}/data/core/odysseus/logs:/app/logs:z
      - {{LAB_DIR}}/data/core/odysseus/data/ssh:/app/.ssh:z
      - {{LAB_DIR}}/data/core/odysseus/data/huggingface:/app/.cache/huggingface:z
      - {{LAB_DIR}}/data/core/odysseus/data/local:/app/.local:z
      # Contrato de carpetas del hub (Fase 3 — RW por carpeta):
      # base RO; escriben los agentes SOLO en las carpetas de conocimiento del
      # lab (aditivo, versioning Syncthing 90d como red). Las carpetas de
      # empresa, companies/ y .state/ quedan RO — las escriben sus pipelines.
      - {{LAB_DIR}}/knowledge:/app/data/knowledge:ro,z
      - {{LAB_DIR}}/knowledge/shared:/app/data/knowledge/shared:z
      - {{LAB_DIR}}/knowledge/projects:/app/data/knowledge/projects:z
      - {{LAB_DIR}}/knowledge/research:/app/data/knowledge/research:z
      - {{LAB_DIR}}/knowledge/daily:/app/data/knowledge/daily:z
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - LLM_HOST=${LLM_HOST:-}
      - LLM_HOSTS=${LLM_HOSTS:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - OLLAMA_BASE_URL=${OLLAMA_BASE_URL:-}
      - RESEARCH_LLM_ENDPOINT=${RESEARCH_LLM_ENDPOINT:-}
      - HF_TOKEN=${HF_TOKEN:-}
      - HUGGING_FACE_HUB_TOKEN=${HUGGING_FACE_HUB_TOKEN:-}
      - SEARXNG_INSTANCE=http://searxng:8080
      - ODYSSEUS_INTERNAL_TOKEN=${ODYSSEUS_INTERNAL_TOKEN:-}
      - CHROMADB_HOST=chromadb-odysseus
      - CHROMADB_PORT=8000
      - DATABASE_URL=sqlite:///./data/app.db
      - AUTH_ENABLED=true
      - LOCALHOST_BYPASS=false
      - ODYSSEUS_ADMIN_USER=${ODYSSEUS_ADMIN_USER:-admin}
      - ODYSSEUS_ADMIN_PASSWORD=${ODYSSEUS_ADMIN_PASSWORD:-}
      - ALLOWED_ORIGINS=${ALLOWED_ORIGINS:-http://localhost:7000}
      - SECURE_COOKIES=false
      - EMBEDDING_URL=${EMBEDDING_URL:-}
      - EMBEDDING_MODEL=${EMBEDDING_MODEL:-}
      - EMBEDDING_API_KEY=${EMBEDDING_API_KEY:-}
      - FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
      - FASTEMBED_CACHE_PATH=
      - CLEANUP_INTERVAL_HOURS=24
      - ODYSSEUS_INPROCESS_POLLERS=1
      - ODYSSEUS_INPROCESS_TASKS=1
      - ODYSSEUS_SCRIPT_HOST=localhost
      - ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=10485760
      - ODYSSEUS_MAX_INLINE_ATTACHMENT_CHARS=${ODYSSEUS_MAX_INLINE_ATTACHMENT_CHARS:-1300000}
      - ODYSSEUS_GALLERY_UPLOAD_MAX_BYTES=104857600
      - ODYSSEUS_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400
      - ODYSSEUS_MEMORY_IMPORT_MAX_BYTES=10485760
      - ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=26214400
      - ODYSSEUS_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=26214400
      - ODYSSEUS_STT_MAX_AUDIO_BYTES=26214400
      - ODYSSEUS_ICS_MAX_BYTES=10485760
      - DATA_BRAVE_API_KEY=${DATA_BRAVE_API_KEY:-}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
      - GOOGLE_PSE_CX=${GOOGLE_PSE_CX:-}
      - TAVILY_API_KEY=${TAVILY_API_KEY:-}
      - SERPER_API_KEY=${SERPER_API_KEY:-}
      - PUID=1000
      - PGID=1000
    depends_on:
      chromadb-odysseus:
        condition: service_started
    deploy:
      resources:
        limits:
          memory: 1536M
          cpus: '3.0'
    networks:
      - odysseus-internal
      - ai-lab-net
    restart: unless-stopped
    # Rotación de logs (Docker json-file): acota el crecimiento del log del
    # contenedor. Los json.log viven en /var/lib/docker (root) — el logrotate
    # user-level del lab no los alcanza; esta es la vía correcta.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ChromaDB dedicado para Odysseus — instancia nueva, no existia en el lab.
  # El lab usa mem0+Qdrant para memoria vectorial de Hermes.
  # Este ChromaDB es para RAG/memoria de Odysseus (dominio separado).
  chromadb-odysseus:
    image: docker.io/chromadb/chroma:latest
    container_name: chromadb-odysseus
    ports:
      - "127.0.0.1:8100:8000"
    volumes:
      - chromadb-odysseus-data:/chroma/chroma
    environment:
      - ANONYMIZED_TELEMETRY=FALSE
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '1.0'
    networks:
      - odysseus-internal
      - ai-lab-net
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  odysseus-internal:
    driver: bridge
  ai-lab-net:
    external: true

volumes:
  chromadb-odysseus-data:
